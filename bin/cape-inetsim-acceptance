#!/usr/bin/env bash
set -Eeuo pipefail

ROOT="${AUTODEPLOY_ROOT:-/usr/local/lib/cape-inetsim-autodeploy}"
[[ -f "$ROOT/lib/state.sh" ]] || ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
AUTODEPLOY_ROOT="$ROOT"
export AUTODEPLOY_ROOT

source "$ROOT/lib/common.sh"
source "$ROOT/lib/targets.sh"
source "$ROOT/lib/state.sh"

POSITIVE_TASK=""
NEGATIVE_TASK=""
MARKER=""
OUTPUT=""

usage(){
  cat <<EOF
Usage:
  sudo ./install --acceptance --positive-task ID --negative-task ID --marker UNIQUE_HOST

This is read-only with respect to CAPE, libvirt, Windows and networking.
It validates a controlled route=none task pair already completed on the host.
The positive task must contain the exact unique marker and INetSim evidence.
The negative task must not contain that marker; ordinary Windows background
traffic to INetSim is allowed and is not treated as a negative-control failure.
EOF
}

while (($#)); do
  case "$1" in
    --positive-task)
      [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || { echo "--positive-task requires an integer" >&2; exit 2; }
      POSITIVE_TASK="$2"; shift 2 ;;
    --negative-task)
      [[ $# -ge 2 && "$2" =~ ^[0-9]+$ ]] || { echo "--negative-task requires an integer" >&2; exit 2; }
      NEGATIVE_TASK="$2"; shift 2 ;;
    --marker)
      [[ $# -ge 2 && -n "$2" ]] || { echo "--marker requires a non-empty unique hostname" >&2; exit 2; }
      MARKER="$2"; shift 2 ;;
    --output)
      [[ $# -ge 2 ]] || { echo "--output requires a path" >&2; exit 2; }
      OUTPUT="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; usage >&2; exit 2 ;;
  esac
done

[[ -n "$POSITIVE_TASK" && -n "$NEGATIVE_TASK" && -n "$MARKER" ]] || {
  fail "Functional acceptance requires --positive-task, --negative-task and --marker"
  usage >&2
  exit 2
}

require_root
state_load || { fail "No deployment state exists"; exit 1; }
[[ "${DEPLOYMENT_PHASE:-}" == committed ]] || {
  fail "Functional acceptance requires a committed deployment (current phase: ${DEPLOYMENT_PHASE:-unknown})"
  exit 1
}

bash "$ROOT/bin/cape-inetsim-verify"

install -d -m 0700 "$AD_LOG_ROOT"
[[ -n "$OUTPUT" ]] || OUTPUT="$AD_LOG_ROOT/${DEPLOYMENT_ID}-functional-acceptance.json"

python3 "$ROOT/tools/acceptance_reports.py"   --cape-root "$CAPE_ROOT"   --inetsim-ip "$INETSIM_IP"   --positive-task "$POSITIVE_TASK"   --negative-task "$NEGATIVE_TASK"   --marker "$MARKER"   --output "$OUTPUT"

find_pcap() {
  local task="$1" base="$CAPE_ROOT/storage/analyses/$task"
  local p
  for p in "$base/dump.pcap" "$base/dump_sorted.pcap"; do
    [[ -f "$p" ]] && { printf '%s\n' "$p"; return 0; }
  done
  return 1
}

POS_PCAP="$(find_pcap "$POSITIVE_TASK")" || {
  fail "Positive task $POSITIVE_TASK has no local CAPE packet capture"
  exit 21
}
NEG_PCAP="$(find_pcap "$NEGATIVE_TASK")" || {
  fail "Negative task $NEGATIVE_TASK has no local CAPE packet capture"
  exit 22
}

have tcpdump || { fail "tcpdump is required for functional packet-capture acceptance"; exit 23; }

pcap_has_inetsim() {
  timeout 15 tcpdump -nn -r "$1" -c 1 "host $INETSIM_IP" >/dev/null 2>&1
}

pcap_has_marker() {
  timeout 15 tcpdump -nn -vvv -A -s 0 -r "$1" "host $INETSIM_IP" 2>/dev/null |
    awk -v marker="$MARKER" '
      BEGIN { marker=tolower(marker); found=0 }
      index(tolower($0), marker) { found=1 }
      END { exit(found ? 0 : 1) }
    '
}

pcap_has_inetsim "$POS_PCAP" || {
  fail "Positive task $POSITIVE_TASK has no packet-capture traffic for $INETSIM_IP"
  exit 24
}

pcap_has_marker "$POS_PCAP" || {
  fail "Positive task $POSITIVE_TASK packet capture does not contain acceptance marker $MARKER"
  exit 25
}

if pcap_has_marker "$NEG_PCAP"; then
  fail "Negative-control task $NEGATIVE_TASK unexpectedly contains acceptance marker $MARKER"
  exit 26
fi

NEG_HAS_INETSIM=false
pcap_has_inetsim "$NEG_PCAP" && NEG_HAS_INETSIM=true

grep -Rqs 'CAPE_INETSIM_VM_ROUTE_NONE_V1' "$CAPE_ROOT/web" || {
  fail "Installed extension route=none marker is missing"
  exit 27
}

python3 - "$OUTPUT" "$POS_PCAP" "$NEG_PCAP" "$MARKER" "$NEG_HAS_INETSIM" "${RELEASE_TAG:-}" "${RELEASE_SOURCE_COMMIT:-}" "${RELEASE_SOURCE_SHA256:-}" <<'PY'
import json,pathlib,sys
path,pos,neg,marker,neg_has_inetsim,release_tag,release_commit,release_sha=sys.argv[1:]
p=pathlib.Path(path)
d=json.loads(p.read_text())
d["pcap_validation"]={
    "positive_capture":pos,
    "positive_contains_inetsim_ip":True,
    "positive_contains_marker":True,
    "negative_capture":neg,
    "negative_contains_marker":False,
    "negative_contains_inetsim_ip":neg_has_inetsim.lower()=="true",
    "background_inetsim_allowed_in_negative":True,
}
d["release_validation"]={
    "manifest_and_structural_verification":"PASS",
    "recovery_assets":"PASS",
    "release_tag":release_tag or None,
    "release_source_commit":release_commit or None,
    "release_source_sha256":release_sha or None,
}
d["marker"]=marker
d["status"]="pass"
p.write_text(json.dumps(d,indent=2)+"\n")
PY

pass "Marker-based positive/negative real-task functional acceptance passed"
kv "positive task:" "$POSITIVE_TASK"
kv "negative task:" "$NEGATIVE_TASK"
kv "marker:" "$MARKER"
kv "acceptance evidence:" "$OUTPUT"
